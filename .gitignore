# Build artifacts
build/
.pio/
.pioenvs/
.piolibdeps/
sdkconfig.old
managed_components/
dependencies.lock

# LittleFS image staging. scripts/flash.sh fs copies the generated error-code bundle in
# here before `pio run -t uploadfs`; the source of truth is docs/codes/.
firmware/data/

# NOT ignored, deliberately: firmware/generated/error_codes.h. It is generated from
# docs/codes/ but committed, so the firmware builds on a machine with PlatformIO and no
# Python toolchain. CI fails if it goes stale.

# Wireviz intermediates (keep only the .svg render alongside the .yml source)
hardware/harness/*.png
hardware/harness/*.html
hardware/harness/*.gv
hardware/harness/*.tsv

# NOT ignored, deliberately: hardware/schematic/starter_photo.jpg. It is the
# build input for starter_annotated.py, which embeds it in the sheet.

# LaTeX intermediates (keep only the .svg render alongside the .tex source)
hardware/schematic/*.dvi
hardware/schematic/*.aux
hardware/schematic/*.log
hardware/schematic/*.build.log

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Python
__pycache__/
*.pyc
