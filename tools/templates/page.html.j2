<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ doc.code }} — {{ doc.title }}</title>
<style>{{ style }}</style>
</head>
<body>
<main>

<header class="code-head sev-{{ doc.severity }}">
  <div class="code-id">{{ doc.code }}<span class="sev-tag">{{ doc.severity }}</span></div>
  <h1 class="code-title">{{ doc.title }}</h1>
  <p class="code-summary">{{ doc.summary }}</p>
</header>

<dl class="facts">
  <dt>State</dt><dd>{{ doc.state }}</dd>
  <dt>Status LED</dt><dd>{{ doc.led }}</dd>
  <dt>Clears</dt><dd>{{ clears_text }}</dd>
  <dt>Firmware event</dt><dd><code>{{ doc.event }}</code></dd>
</dl>

{{ body }}

<section class="refs">
<h2>Full detail</h2>
<p class="offline-note">You are connected to the saw, not to the internet. These links
open once you disconnect from <strong>ALN Table Saw</strong> — or scan the code with
another phone. The instructions above are complete on their own; these are for depth.</p>
{% for ref in doc.refs %}
<div class="ref">
  {% if ref.qr %}<div class="qr">{{ ref.qr }}</div>{% endif %}
  <div>
    <div class="ref-title">{{ ref.title }}</div>
    <div class="ref-url">{{ ref.url }}</div>
  </div>
</div>
{% endfor %}
</section>

<a class="backlink" href="index.html">&larr; All error codes</a>

<footer>
<p>Error code registry {{ registry_version }} &middot; built from {{ commit }} ({{ commit_date }})</p>
<p>This copy was bundled into the firmware and does not update itself. GitHub is the
canonical source and may be newer.</p>
</footer>

</main>
</body>
</html>
